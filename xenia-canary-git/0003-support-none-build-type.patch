diff --git i/CMakeLists.txt w/CMakeLists.txt
index 30febc4b7..6e531957e 100644
--- i/CMakeLists.txt
+++ w/CMakeLists.txt
@@ -163,8 +163,8 @@ if(MSVC)
   # Debug already has /Zi by default
 
