-    X86_SSSE3
-    X86_SSE42
-    X86_AVX2
-    X86_AVX512
-    X86_AVX512VNNI
-    WITH_GZFILEOP
-  )
-  if(NOT MSVC)
-    # GCC/Clang have native __builtin_ctz/__builtin_ctzll (MSVC gets these
