        'libpng-1.6.58.tar.xz::https://downloads.sourceforge.net/project/libpng/libpng16/1.6.58/libpng-1.6.58.tar.xz'
        'libpng-1.6.58-apng.patch.gz::https://downloads.sourceforge.net/project/libpng-apng/libpng16/1.6.58/libpng-1.6.58-apng.patch.gz'
        'bypass-checks.patch'
        'system-libs.patch'
        'libpng-apng-fix.patch'
        'sdl3-steam.patch')
b2sums=('SKIP'
