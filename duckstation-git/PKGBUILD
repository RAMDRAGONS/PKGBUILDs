pkgname=duckstation-git
pkgver=0.1.r11790.2ca830751
pkgrel=1
pkgdesc="Fast PlayStation 1 emulator for PC and Android (Git version)"
arch=('x86_64' 'aarch64')
url="https://github.com/stenzek/duckstation"
license=('CC-BY-NC-ND-4.0')
depends=('qt6-base' 'qt6-svg' 'qt6-wayland' 'sdl3' 'curl' 'libzip' 'libwebp' 'zstd' 'libjpeg-turbo' 'freetype2' 'harfbuzz' 'spirv-cross' 'dbus' 'libbacktrace')
makedepends=('git' 'cmake' 'ninja' 'qt6-tools' 'extra-cmake-modules' 'vulkan-headers' 'clang')
optdepends=('discord-rpc: for Discord integration'
            'libcpuinfo: for better CPU detection'
            'plutosvg: for SVG support')
source=('duckstation::git+https://github.com/stenzek/duckstation.git'
        'cpuinfo::git+https://github.com/stenzek/cpuinfo.git'
        'shaderc::git+https://github.com/stenzek/shaderc.git'
        'discord-rpc::git+https://github.com/stenzek/discord-rpc.git'
        'soundtouch::git+https://github.com/stenzek/soundtouch.git'
        'libpng-1.6.56.tar.xz::https://downloads.sourceforge.net/project/libpng/libpng16/1.6.56/libpng-1.6.56.tar.xz'
        'libpng-1.6.56-apng.patch.gz::https://downloads.sourceforge.net/project/libpng-apng/libpng16/1.6.56/libpng-1.6.56-apng.patch.gz'
        'bypass-checks.patch'
        'system-libs.patch'
        'libpng-apng-fix.patch')
