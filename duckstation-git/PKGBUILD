pkgname=duckstation-git
pkgver=0.1.r11898.02a41fa06
pkgrel=1
pkgdesc="Fast PlayStation 1 emulator for PC and Android (Git version)"
arch=('x86_64' 'aarch64')
url="https://github.com/stenzek/duckstation"
license=('CC-BY-NC-ND-4.0')
depends=('qt6-base' 'qt6-svg' 'qt6-wayland' 'sdl3' 'curl' 'libzip' 'libwebp' 'zstd' 'libjpeg-turbo' 'freetype2' 'harfbuzz' 'spirv-cross' 'dbus' 'libbacktrace')
makedepends=('git' 'cmake' 'ninja' 'qt6-tools' 'extra-cmake-modules' 'vulkan-headers' 'clang')
optdepends=('discord-rpc: for Discord integration'
            'libcpuinfo: for better CPU detection'
            'plutosvg: for SVG support')
