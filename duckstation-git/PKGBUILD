pkgver() {
  cd duckstation
  printf "0.1.r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  # Download cheats.zip and patches.zip and update them conditionally
  local_cheats=""
  [ -f "$srcdir/cheats.zip" ] && local_cheats="-z $srcdir/cheats.zip"
  echo "Checking/downloading cheats.zip..."
  curl -R -L $local_cheats -o "$srcdir/cheats.zip" "https://github.com/duckstation/chtdb/releases/download/latest/cheats.zip" || [ -f "$srcdir/cheats.zip" ]

  local_patches=""
  [ -f "$srcdir/patches.zip" ] && local_patches="-z $srcdir/patches.zip"
  echo "Checking/downloading patches.zip..."
  curl -R -L $local_patches -o "$srcdir/patches.zip" "https://github.com/duckstation/chtdb/releases/download/latest/patches.zip" || [ -f "$srcdir/patches.zip" ]

  cd duckstation
  patch -p1 -i ../bypass-checks.patch
  patch -p1 -i ../system-libs.patch
  patch -p1 -i ../libpng-apng-fix.patch
  patch -p1 -i ../sdl3-steam.patch

  cd "$srcdir/libpng-1.6.58"
  zcat ../libpng-1.6.58-apng.patch.gz | patch -p1

  # Patch soundtouch for static build and visibility
  cd "$srcdir/soundtouch"
  sed -i 's/add_library(SoundTouchDLL SHARED/add_library(SoundTouchDLL STATIC/' CMakeLists.txt
  sed -i 's/install(TARGETS SoundTouchDLL EXPORT SoundTouchTargets)/install(TARGETS SoundTouch SoundTouchDLL EXPORT SoundTouchTargets)/' CMakeLists.txt
  sed -i 's/set(CMAKE_C_VISIBILITY_PRESET hidden)//' CMakeLists.txt
  sed -i 's/set(CMAKE_CXX_VISIBILITY_PRESET hidden)//' CMakeLists.txt
  sed -i '1i set(CMAKE_POSITION_INDEPENDENT_CODE ON)' CMakeLists.txt
}


build() {
  # Build private dependencies from forks statically
  mkdir -p "$srcdir/deps-install/include"
  mkdir -p "$srcdir/deps-install/lib"

  # cpuinfo
  mkdir -p "$srcdir/cpuinfo-build"
  cd "$srcdir/cpuinfo-build"
  cmake "$srcdir/cpuinfo" \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX="$srcdir/deps-install" \
    -DCPUINFO_BUILD_TOOLS=OFF \
    -DCPUINFO_BUILD_UNIT_TESTS=OFF \
    -DCPUINFO_BUILD_MOCK_TESTS=OFF \
    -DCPUINFO_BUILD_BENCHMARKS=OFF \
    -DCPUINFO_LIBRARY_TYPE=static
  make install

  # shaderc
  mkdir -p "$srcdir/shaderc-build"
  cd "$srcdir/shaderc-build"
  cmake "$srcdir/shaderc" \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX="$srcdir/deps-install" \
    -DSHADERC_SKIP_TESTS=ON \
    -DSHADERC_SKIP_EXAMPLES=ON \
    -DSHADERC_SKIP_COPYRIGHT_CHECK=ON \
    -DSHADERC_ENABLE_INSTALL=ON
  make install

  # discord-rpc
  mkdir -p "$srcdir/discord-rpc-build"
  cd "$srcdir/discord-rpc-build"
  cmake "$srcdir/discord-rpc" \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX="$srcdir/deps-install" \
    -DBUILD_EXAMPLES=OFF
  make install

  # soundtouch
  mkdir -p "$srcdir/soundtouch-build"
  cd "$srcdir/soundtouch-build"
  cmake "$srcdir/soundtouch" \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX="$srcdir/deps-install" \
    -DSOUNDTOUCH_DLL=ON
  make install

  # libpng with APNG
  mkdir -p "$srcdir/libpng-build"
  cd "$srcdir/libpng-build"
  cmake "$srcdir/libpng-1.6.58" \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX="$srcdir/deps-install" \
    -DPNG_SHARED=OFF \
    -DPNG_STATIC=ON \
    -DPNG_TESTS=OFF \
    -Dld-version-script=OFF
  make install

  # Build DuckStation
  export CC=clang
  export CXX=clang++
  
  cd "$srcdir/duckstation"
  cmake -B build -S . \
    -GNinja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DDEPS_PATH="$srcdir/deps-install" \
    -DCMAKE_INSTALL_RPATH='$ORIGIN' \
    -DENABLE_X11=OFF \
    -DENABLE_WAYLAND=ON \
    -DBUILD_QT_FRONTEND=ON \
    -DUSE_DRC=ON
  ninja -C build
}



package() {
  cd "$srcdir/duckstation"
  install -d "$pkgdir/usr/bin"
  install -d "$pkgdir/usr/lib/duckstation"
  
  # Install binary and resources
  cp -r build/bin/* "$pkgdir/usr/lib/duckstation/"
  
  # Install our private shared libs if any (like shaderc)
  cp "$srcdir/deps-install/lib/"*.so* "$pkgdir/usr/lib/duckstation/" 2>/dev/null || true
  
  # Install cheats and patches zip databases without extraction
  install -d "$pkgdir/usr/lib/duckstation/resources"
  install -m644 "$srcdir/cheats.zip" "$pkgdir/usr/lib/duckstation/resources/cheats.zip"
  install -m644 "$srcdir/patches.zip" "$pkgdir/usr/lib/duckstation/resources/patches.zip"

  # Create symlink for the binary
  ln -s /usr/lib/duckstation/duckstation-qt "$pkgdir/usr/bin/duckstation-qt"
  
  # Install icon
  install -Dm644 data/resources/images/duck.png "$pkgdir/usr/share/pixmaps/duckstation.png"
  
  # Install and fix desktop file
  install -Dm644 scripts/appimage/org.duckstation.DuckStation.desktop "$pkgdir/usr/share/applications/duckstation.desktop"
  sed -i 's/^Icon=.*/Icon=duckstation/' "$pkgdir/usr/share/applications/duckstation.desktop"
}



