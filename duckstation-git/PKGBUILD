pkgname=duckstation-git
pkgver=0.1.r12635.0cafa7633
pkgrel=1
pkgdesc="Fast PlayStation 1 emulator for PC and Android (Git version)"
arch=('x86_64' 'aarch64')
url="https://github.com/stenzek/duckstation"
license=('CC-BY-NC-ND-4.0')
depends=('qt6-base' 'curl' 'zstd' 'libbacktrace' 'glibc' 'systemd-libs' 'libstdc++' 'libgcc' 'zlib' 'sqlite')
makedepends=('git' 'cmake' 'ninja' 'qt6-tools' 'extra-cmake-modules' 'vulkan-headers' 'clang' 'patchelf'
             'sdl3' 'libzip' 'libwebp' 'libjpeg-turbo' 'freetype2' 'harfbuzz' 'spirv-cross' 'sqlite')
optdepends=('discord-rpc: for Discord integration'
