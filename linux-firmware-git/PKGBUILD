    linux-firmware-bnx2x-git
  )
  conflicts=(
    "${pkgname%-git}"
    linux-firmware-bnx2x
    linux-firmware-bnx2x-git
  )
  replaces=('linux-firmware-bnx2x<=20250613.12fe085f-4')
  depends=(linux-firmware-whence-git)

  local _name="${pkgname%-git}"
  mv -v ${_name#linux-firmware-}/* "${pkgdir}"
  make -C ${_pkgbase} FIRMWAREDIR="${pkgdir}/usr/lib/firmware" dedup

  install -Dm644 ${_licdir}/LICENCE.{bnx2*,broadcom_*,cypress,tigon} \
    -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

