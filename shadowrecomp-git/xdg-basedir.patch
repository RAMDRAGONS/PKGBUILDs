+std::filesystem::path BuildGamePath()
+{
+#if defined(__linux__)
+    // The executable may live in a read-only system prefix, so game files go to
+    // $XDG_DATA_HOME per the XDG Base Directory spec unless running portable.
+    // Avoids CheckPortable() because g_executableRoot may not be constructed yet
+    // when other files' static initializers reach this.
+    if (std::filesystem::exists(os::process::GetExecutableRoot() / "portable.txt"))
+        return GAME_INSTALL_DIRECTORY;
+
+    // The spec says relative values must be ignored.
+    const char* dataHome = getenv("XDG_DATA_HOME");
+    if (dataHome != nullptr && dataHome[0] == '/')
+        return std::filesystem::path(dataHome) / USER_DIRECTORY;
+
+    const char* homeDir = getenv("HOME");
+    if (homeDir == nullptr)
+    {
+        const passwd* pw = getpwuid(getuid());
+        homeDir = pw != nullptr ? pw->pw_dir : nullptr;
+    }
+
+    if (homeDir != nullptr)
+        return std::filesystem::path(homeDir) / ".local" / "share" / USER_DIRECTORY;
+#elif defined(__APPLE__)
+    return GetUserPath();
+#endif
+
+    return GAME_INSTALL_DIRECTORY;
+}
+
+const std::filesystem::path& GetGamePath()
+{
+    // Function-local so namespace-scope initializers in other files can call it.
+    static const std::filesystem::path gamePath = BuildGamePath();
+    return gamePath;
+}
