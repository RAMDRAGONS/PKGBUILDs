pkgdesc="An unofficial PC port of the Xbox version of Shadow the Hedgehog, created through the process of static recompilation. (Git version)"
arch=('x86_64')
url="https://github.com/FoxWorkshop/ShadowRecomp"
license=('GPL-3.0-or-later')
depends=('curl' 'dbus' 'directx-shader-compiler' 'fmt' 'glibc' 'hicolor-icon-theme' 'libgcc'
