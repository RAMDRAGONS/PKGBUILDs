# Maintainer: Judas Drekonym <judas.drekonym@gmail.com>

pkgname=tochd-git
_pkgname=tochd
pkgver=0.13.r88.g60a0654
pkgrel=1
pkgdesc="Convert game ISO and archives to CD/DVD CHD for emulation (Git version)."
arch=('any')
url="https://github.com/freitagdavid/tochd"
license=('MIT')
depends=('python3' 'p7zip' 'mame-tools')
makedepends=('git')
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
	cd "$_pkgname"
	printf "0.13.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

check() {
	cd "$_pkgname"
	python3 "$_pkgname.py" --version
}

package() {
	cd "$_pkgname"
	install -m 755 -TD "$_pkgname.py" "$pkgdir/usr/bin/$_pkgname"
	install -m 644 -TD "README.md" "$pkgdir/usr/share/doc/$_pkgname/README.md"
	install -m 644 -TD "LICENSE" "$pkgdir/usr/share/licenses/$_pkgname/LICENSE"
}

