# Maintainer: AltoXorg <atrl101 AT yahoo DOT com>

_reponame=Shipwright
pkgname=soh-git
pkgver=9.2.3.r322.geafafe507e
pkgrel=1
pkgdesc="An unofficial port of The Legend of Zelda Ocarina of Time (git)"
arch=("x86_64" "i686" "armv7h" "aarch64")
url="https://shipofharkinian.com/"
license=("unknown")
depends=("sdl2" "sdl2_net" "zenity" "libzip" "libpng" "libogg" "libvorbis" "opus" "opusfile" "fmt" "spdlog" "tinyxml2")
makedepends=("git" "cmake" "ninja" "python" "curl" "lsb-release" "boost" "nlohmann-json")
provides=("soh" "soh-otr-exporter")
conflicts=("soh" "soh-otr-exporter")
replaces=("soh-otr-exporter-git")
install=soh.install
optdepends=("soh-otr: OTR asset file in order to run"
            "soh-otr-mq: OTR asset file in order to run (Master Quest)")
source=("git+https://github.com/HarbourMasters/${_reponame}.git"
        "git+https://github.com/Kenix3/libultraship.git"
        "git+https://github.com/HarbourMasters/Torch.git"
        "soh.desktop")
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            '25aebd34f6ad49073d8a5ce6915b6fa290470fc6d62a8143abe07a25707ff4a2')

# NOTE: If compiling complains about missing headers, set __generate_headers below to 1
__generate_headers=0  # Generate OTR (unnecessary) and asset headers. **requires rom**

_is_debug() {
  for opt in "${OPTIONS[@]}"; do
    if [ "$opt" = debug ]; then
      return 0
    fi
  done

  return 1
}

SHIP_PREFIX=/opt/soh

pkgver() {
  cd "${srcdir}/${_reponame}"

  git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "${srcdir}/${_reponame}"

  # Init all submodules
  git submodule init
  git config submodule.libultraship.url "$srcdir/libultraship"
  git config submodule.torch.url "$srcdir/Torch"
  git -c protocol.file.allow=always submodule update

  # Fix Context.cpp error: use of undeclared identifier 'GetInstance'; did you mean 'GetRawInstance'?
  sed -i 's/GetInstance()/GetRawInstance()/g' libultraship/src/ship/Context.cpp

  # Fix ABI incompatibility crash (free(): invalid size) with system spdlog by compiling spdlog header-only
  sed -i 's/spdlog::spdlog)/spdlog::spdlog_header_only)/g' libultraship/src/CMakeLists.txt
  sed -i 's/spdlog::spdlog)/spdlog::spdlog_header_only)/g' torch/CMakeLists.txt

  if [ "$__generate_headers" = 1 ]; then
    # check for any roms in the directory where PKGBUILD resides
    # and copy them to Shipwright/roms.
    roms=( "${startdir}/"*.*64 )
    if (( "${#roms[@]}" )); then
      mkdir -p roms
      cp "${roms[@]}" roms/
    else
      echo "NO ROMS FOUND! Please place them in \"${startdir}\"."
      return 1
    fi
  fi
}

build() {
  cd "${srcdir}/${_reponame}"

  if _is_debug; then
    BUILD_TYPE=Debug
  else
    BUILD_TYPE=None
  fi

  CFLAGS="${CFLAGS/-Werror=format-security/}" \
  CXXFLAGS="${CXXFLAGS/-Werror=format-security/}" \
  cmake . \
    -Bbuild \
    -GNinja \
    -DCMAKE_BUILD_TYPE=$BUILD_TYPE \
    -DNON_PORTABLE=On \
    -DCMAKE_INSTALL_PREFIX=$SHIP_PREFIX \
    -DBUILD_REMOTE_CONTROL=1

  cmake --build build --target soh-o2r-packer --config $BUILD_TYPE $NINJAFLAGS
  cmake --build build --target soh-torch --config $BUILD_TYPE $NINJAFLAGS

  if [ "$__generate_headers" = 1 ]; then
    cmake --build build --target ExtractAssets $NINJAFLAGS
  else
    cmake --build build --target GenerateSohOtr $NINJAFLAGS
  fi

  cmake --build build --target soh --config $BUILD_TYPE $NINJAFLAGS
}

package() {
  cd "${srcdir}/${_reponame}"

  DESTDIR="${pkgdir}" cmake --install build --component ship

  # Install Torch tooling
  install -Dm755 build/soh-torch "${pkgdir}${SHIP_PREFIX}/soh-torch"
  install -Dm755 build/soh-o2r-packer "${pkgdir}${SHIP_PREFIX}/soh-o2r-packer"

  install -dm755 "${pkgdir}/usr/bin/"
  ln -s "${SHIP_PREFIX}/soh.elf" "${pkgdir}/usr/bin/soh"
  ln -s "${SHIP_PREFIX}/soh-torch" "${pkgdir}/usr/bin/soh-torch"
  ln -s "${SHIP_PREFIX}/soh-o2r-packer" "${pkgdir}/usr/bin/soh-o2r-packer"

  install -Dm644 "${srcdir}/soh.desktop" -t "${pkgdir}/usr/share/applications"
  install -Dm644 soh/macosx/sohIcon.png "${pkgdir}/usr/share/pixmaps/soh.png"

  # Copy game documentation & licenses
  install -dm755 "${pkgdir}/usr/share/doc/soh"
  install -Dm644 "README.md" "${pkgdir}/usr/share/doc/soh"
  cp -r docs "${pkgdir}/usr/share/doc/soh/docs"

  install -dm755 "${pkgdir}/usr/share/licenses/soh-git"
  install -Dm644 "torch/LICENSE" "${pkgdir}/usr/share/licenses/soh-git/LICENSE-torch"
}
