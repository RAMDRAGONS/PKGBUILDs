# Maintainer: Judas Drekonym <judas.drekonym@gmail.com>

pkgname=msbt-editor-git
pkgver=3.1.0.r3.g9fbf178
pkgrel=1
pkgdesc="A modern editor for MSBT and BMG files. (Git version)"
arch=('x86_64')
url="https://gitlab.com/AeonSake/msbt-editor"
license=('GPL-3.0-only')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'gcc-libs'
  'glibc'
  'libcups'
  'libx11'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'libxrender'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'zlib'
)
makedepends=('git' 'dotnet-sdk-10.0' 'npm')
provides=('msbt-editor')
conflicts=('msbt-editor')
source=(
  "git+https://gitlab.com/AeonSake/msbt-editor.git"
  "msbteditor-app.desktop"
  "msbt-editor.sh"
)
sha256sums=('SKIP'
            'abbeb95b2ff0f2c8ae7f89d42fbc799b0ffffc2c9b2ab40ba45d76dc5d688c4c'
            '7cb5f1a894ba3d3a4e328f23e8e99f0ddb68f6171e483cb8b706e1f50712ad48')

pkgver() {
  cd msbt-editor
  git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd msbt-editor
  export DOTNET_CLI_TELEMETRY_OPTOUT=1
  export DOTNET_NOLOGO=1
  dotnet restore src/MsbtEditor.App/MsbtEditor.App.csproj -r linux-x64
}

build() {
  cd msbt-editor
  export DOTNET_CLI_TELEMETRY_OPTOUT=1
  export DOTNET_NOLOGO=1
  dotnet publish src/MsbtEditor.App/MsbtEditor.App.csproj -c Release -r linux-x64 -p:PublishProfile=linux-x64 --no-restore
}

package() {
  # Install application binaries
  install -dm755 "$pkgdir/opt/msbt-editor"
  cp -a msbt-editor/src/MsbtEditor.App/bin/Release/net10.0/linux-x64/publish/linux-unpacked/* "$pkgdir/opt/msbt-editor/"

  # Remove LTTng tracing library to prevent checkrebuild from flagging missing liblttng-ust.so.0
  rm -f "$pkgdir/opt/msbt-editor/resources/bin/libcoreclrtraceptprovider.so"

  # Install launcher script
  install -Dm755 msbt-editor.sh "$pkgdir/usr/bin/msbt-editor"

  # Install desktop file and icon
  install -Dm644 msbteditor-app.desktop "$pkgdir/usr/share/applications/msbteditor-app.desktop"
  install -Dm644 msbt-editor/src/assets/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/msbteditor-app.png"
}
