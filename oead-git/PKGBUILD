# Maintainer: Judas Drekonym <judas.drekonym@gmail.com>

pkgname=oead-git
_name=oead
pkgver=1.3.0.r4.ga10db5c
pkgrel=1
pkgdesc="Library for recent Nintendo EAD formats in first-party games (C++ shared library and Python module)"
arch=('x86_64')
url="https://github.com/zeldamods/oead"
license=('GPL-2.0-or-later')
depends=('abseil-cpp' 'libyaml' 'python')
makedepends=('git' 'cmake' 'pkgconf' 'pybind11' 'python-build' 'python-installer' 'python-wheel' 'python-scikit-build-core' 'python-setuptools-scm')
provides=('oead' 'python-oead')
conflicts=('oead' 'python-oead')
source=("git+https://github.com/zeldamods/oead.git")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/${_name}"
  git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g;s/^v//'
}

prepare() {
  cd "${srcdir}/${_name}"
  # Initialize required submodules while offloading Abseil, LibYAML, and pybind11 to system packages
  git submodule update --init --recursive lib/ordered-map lib/rapidyaml lib/zlib-ng lib/libyaml

  # Dynamically patch CMakeLists.txt to offload Abseil & LibYAML to system packages,
  # build rapidyaml statically into liboead to avoid missing runtime libraries,
  # disable zlib-ng tests, and keep custom zlib-ng fork submodule.
  python -c '
with open("CMakeLists.txt", "r") as f:
    content = f.read()

target = """function(oead_add_vendored_libraries)
  # libyaml requires CMake 3.10, so option() would otherwise ignore the variables below.
  set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
  set(BUILD_TESTING OFF)
  set(WITH_GZFILEOP OFF)
  add_subdirectory(lib/abseil)
  add_subdirectory(lib/libyaml)
  add_subdirectory(lib/ordered-map)
  add_subdirectory(lib/rapidyaml)
  add_subdirectory(lib/zlib-ng)
endfunction()
oead_add_vendored_libraries()"""

replacement = """# Use system versions where they exist
find_package(absl REQUIRED CONFIG)

find_package(PkgConfig REQUIRED)
pkg_check_modules(YAML REQUIRED IMPORTED_TARGET yaml-0.1)
add_library(yaml INTERFACE IMPORTED)
target_link_libraries(yaml INTERFACE PkgConfig::YAML)

add_library(tsl::ordered_map INTERFACE IMPORTED)
set_target_properties(tsl::ordered_map PROPERTIES
  INTERFACE_INCLUDE_DIRECTORIES "${CMAKE_CURRENT_SOURCE_DIR}/lib/ordered-map/include"
)

set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
set(BUILD_TESTING OFF)
set(WITH_GZFILEOP OFF)

# Rapidyaml is static to embed into liboead without missing unbundled shared lib at runtime
set(BUILD_SHARED_LIBS_SAVED ${BUILD_SHARED_LIBS})
set(BUILD_SHARED_LIBS OFF)
add_subdirectory(lib/rapidyaml)
set(BUILD_SHARED_LIBS ${BUILD_SHARED_LIBS_SAVED})

add_subdirectory(lib/zlib-ng)"""

assert target in content, "Could not patch CMakeLists.txt, target string not found"
content = content.replace(target, replacement)
with open("CMakeLists.txt", "w") as f:
    f.write(content)
print("Successfully patched CMakeLists.txt")
'

  # Patch py/CMakeLists.txt to use system pybind11 instead of the submodule
  python -c '
with open("py/CMakeLists.txt", "r") as f:
    content = f.read()

target = """set(PYBIND11_FINDPYTHON ON)
add_subdirectory(../lib/pybind11 pybind11)"""

replacement = """find_package(pybind11 CONFIG REQUIRED)"""

assert target in content, "Could not patch py/CMakeLists.txt, target string not found"
content = content.replace(target, replacement)
with open("py/CMakeLists.txt", "w") as f:
    f.write(content)
print("Successfully patched py/CMakeLists.txt")
'
}

build() {
  # Build C++ shared library
  cmake -B build -S "${_name}" \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_SHARED_LIBS=ON \
    -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
    -Wno-dev
  cmake --build build

  # Build Python wheel
  cd "${srcdir}/${_name}"
  python -m build --wheel --no-isolation
}

package() {
  # Install the C++ shared library
  install -Dm755 build/liboead.so "${pkgdir}/usr/lib/liboead.so"

  # Install public headers
  mkdir -p "${pkgdir}/usr/include"
  cp -r "${srcdir}/${_name}/src/include/oead" "${pkgdir}/usr/include/"

  # Install required utility headers (nonstd)
  cp -r "${srcdir}/${_name}/lib/nonstd/nonstd" "${pkgdir}/usr/include/"

  # Install required tsl headers (ordered-map)
  cp -r "${srcdir}/${_name}/lib/ordered-map/include/tsl" "${pkgdir}/usr/include/"

  # Ensure correct directory & file permissions
  find "${pkgdir}/usr/include" -type f -exec chmod 644 {} +
  find "${pkgdir}/usr/include" -type d -exec chmod 755 {} +

  # Install Python module
  cd "${srcdir}/${_name}"
  python -m installer --destdir="${pkgdir}" dist/*.whl

  # Install license
  install -Dm644 "${srcdir}/${_name}/LICENSE.md" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.md"
}
