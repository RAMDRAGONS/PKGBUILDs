diff --git i/CMakeLists.txt w/CMakeLists.txt
index 7f95fd7a..d73d3d87 100644
--- i/CMakeLists.txt
+++ w/CMakeLists.txt
@@ -1,6 +1,8 @@
 cmake_minimum_required (VERSION 3.20)
 
-if(NOT DEFINED ENV{VCPKG_ROOT})
+option(MARATHON_RECOMP_USE_SYSTEM_LIBS "Use system libraries" OFF)
+
+if(NOT MARATHON_RECOMP_USE_SYSTEM_LIBS AND NOT DEFINED ENV{VCPKG_ROOT})
     message(FATAL_ERROR "VCPKG_ROOT is not defined!")
 endif()
 
@@ -19,6 +21,22 @@ set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
 
 project("MarathonRecomp-ALL")
 
+if(MARATHON_RECOMP_USE_SYSTEM_LIBS)
+    find_package(PkgConfig REQUIRED)
+    find_package(fmt REQUIRED)
+    find_package(tomlplusplus REQUIRED)
+    find_package(SDL3 REQUIRED CONFIG)
+    find_package(SDL3_mixer REQUIRED CONFIG)
+    pkg_check_modules(xxHash REQUIRED IMPORTED_TARGET libxxhash)
+    add_library(xxHash::xxhash ALIAS PkgConfig::xxHash)
+    pkg_check_modules(zstd REQUIRED IMPORTED_TARGET libzstd)
+    add_library(libzstd ALIAS PkgConfig::zstd)
+    add_library(libzstd_static ALIAS PkgConfig::zstd)
+    if(NOT TARGET SDL3::SDL3-static)
+        add_library(SDL3::SDL3-static ALIAS SDL3::SDL3-shared)
+    endif()
+endif()
+
 if (APPLE)
     enable_language(OBJC OBJCXX)
 endif()
@@ -33,13 +51,6 @@ endif()
 string(TOLOWER "${MARATHON_RECOMP_ARCHITECTURE}" MARATHON_RECOMP_ARCHITECTURE)
 message(STATUS "Detected architecture: ${MARATHON_RECOMP_ARCHITECTURE}")
 
-if (MARATHON_RECOMP_ARCHITECTURE STREQUAL "x86_64" OR MARATHON_RECOMP_ARCHITECTURE STREQUAL "amd64")
-    # Target Sandy Bridge for all projects
-    add_compile_options(
-        -march=sandybridge
-    )
-endif()
-
 if (CMAKE_BUILD_TYPE STREQUAL "Debug")
     # Normally only defined by Visual Studio, added for consistency
     add_compile_definitions(_DEBUG)
