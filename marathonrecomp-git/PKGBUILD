# Points the listed submodules (path=source-dir) of a checkout at the local
# clones in $srcdir. Unlisted ones (vendored SDL, SDL_mixer, fmt, tomlplusplus,
# xxHash, zstd, vcpkg...) stay uninitialized because system packages replace them.
_submodules() {
  local _dir=$1 _entry
  shift
  git -C "$_dir" submodule init "${@%%=*}"
  for _entry in "$@"; do
    git -C "$_dir" config "submodule.${_entry%%=*}.url" "$srcdir/${_entry#*=}"
  done
  git -C "$_dir" -c protocol.file.allow=always submodule update --force "${@%%=*}"
}

pkgver() {
  cd "$_pkgname"
  ( set -o pipefail
    git describe --long --tags --abbrev=7 2>/dev/null |
      sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  )
}

prepare() {
  cd "$_pkgname"

  _submodules . \
    MarathonRecompResources=MarathonRecompResources \
    thirdparty/concurrentqueue=concurrentqueue \
    thirdparty/ddspp=ddspp \
    thirdparty/ffmpeg-core=ffmpeg-core \
    thirdparty/imgui=imgui \
    thirdparty/implot=implot \
    thirdparty/json=json \
    thirdparty/magic_enum=magic_enum \
    thirdparty/msdf-atlas-gen=msdf-atlas-gen \
    thirdparty/nativefiledialog-extended=nativefiledialog-extended \
    thirdparty/plume=plume \
    thirdparty/stb=stb \
    thirdparty/unordered_dense=unordered_dense \
    tools/XenonRecomp=XenonRecomp \
    tools/XenosRecomp=XenosRecomp
  _submodules thirdparty/msdf-atlas-gen \
    artery-font-format=artery-font-format \
    msdfgen=msdfgen
  _submodules thirdparty/plume \
    contrib/volk=volk \
    contrib/VulkanMemoryAllocator=VulkanMemoryAllocator
  _submodules tools/XenonRecomp \
    thirdparty/libmspack=libmspack \
    thirdparty/simde=simde-no-tests \
    thirdparty/tiny-AES-c=tiny-AES-c
  _submodules tools/XenosRecomp \
    thirdparty/dxc-bin=dxc-bin \
    thirdparty/smol-v=smol-v

  patch -Np1 -i "$srcdir/system-libs.patch"
  patch -Np1 -i "$srcdir/fmt-10-compat.patch"
  patch -Np1 -i "$srcdir/guestbasetexture-destructor.patch"
  mkdir -p MarathonRecompLib/private
  cp "$srcdir/default.xex" "$srcdir/shader.arc" "$srcdir/shader_lt.arc" MarathonRecompLib/private/
}

build() {
  cd "$_pkgname"
  export CC=clang
  export CXX=clang++
  export LDFLAGS="-fuse-ld=lld $LDFLAGS"
  cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DMARATHON_RECOMP_USE_SYSTEM_LIBS=ON \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  cd "$_pkgname"
  install -Dm755 build/MarathonRecomp/MarathonRecomp "$pkgdir/usr/bin/marathonrecomp"
  install -Dm644 MarathonRecompResources/images/game_icon.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/$_appid.png"
  install -Dm644 "flatpak/$_appid.metainfo.xml" "$pkgdir/usr/share/metainfo/$_appid.metainfo.xml"
  install -Dm644 "flatpak/$_appid.desktop" "$pkgdir/usr/share/applications/$_appid.desktop"
  sed -i 's|Exec=/app/bin/MarathonRecomp|Exec=marathonrecomp|' "$pkgdir/usr/share/applications/$_appid.desktop"
}
